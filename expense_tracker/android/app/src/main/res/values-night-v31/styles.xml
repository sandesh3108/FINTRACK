<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) launch theme with dark mode active - same handover to
  NormalTheme as the light variant, but on the dark app background.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background_night</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <!-- No android:postSplashScreenTheme: not present in the Android 12
             SDK, so it would fail resource linking. -->
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
