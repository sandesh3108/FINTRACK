<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) launch theme.

  The platform now owns the splash screen, so the branded plate and centred
  mark are supplied through windowSplashScreenBackground /
  windowSplashScreenAnimatedIcon instead of only through windowBackground.
  After the splash exits the window hands over to NormalTheme.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <!-- Note: no android:postSplashScreenTheme here. It was dropped from
             the final Android 12 SDK and does not exist in the platform, so
             referencing it fails resource linking. Flutter switches the window
             to NormalTheme itself once the first frame is drawn. -->
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
