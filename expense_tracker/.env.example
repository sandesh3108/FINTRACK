# =============================================================================
# Expense Tracker - build-time configuration
# =============================================================================
#
# This project does NOT load `.env` files at runtime. Every value below is a
# Flutter `--dart-define` passed at build time, so nothing secret ever lands in
# source control or in the repository history.
#
# Note: the Google OAuth ids below are the one exception to "build time only" -
# they can also be typed into Settings -> Google Sheets setup and are then kept
# in the settings table instead of in the APK.
#
# Copy this file for your own reference and pass the values on the command line:
#
#   flutter build apk --release ^
#     --dart-define=APP_NAME="FINTRACK" ^
#     --dart-define=SUPPORT_EMAIL="help@example.com" ^
#     --dart-define=WEBSITE_URL="https://example.com" ^
#     --dart-define=GITHUB_URL="https://github.com/example/expense-tracker" ^
#     --dart-define=GOOGLE_CLIENT_ID_ANDROID="1234-abc.apps.googleusercontent.com" ^
#     --dart-define=GOOGLE_CLIENT_ID_WEB="5678-def.apps.googleusercontent.com" ^
#     --dart-define=GOOGLE_PROJECT_ID="my-project-123"
#
# Public OAuth *client IDs* are not secrets (they ship inside every installed
# APK), but they are still supplied here so they are not hard-coded in source.
# Never place a client secret, service-account key or refresh token in this
# project: Android apps cannot keep those private.
# =============================================================================

# --- Branding ---------------------------------------------------------------
# The name shown inside the app. Also set on the launcher icon by hand:
# android/app/src/main/res/values/strings.xml -> <string name="app_name">.
APP_NAME=FINTRACK
# Informational only - the id actually compiled into the APK comes from
# android/app/build.gradle.kts (applicationId). Keep the two in sync.
PACKAGE_NAME=com.sandeep.expense_tracker
# Credit shown in the About, Contact and More footers.
DEVELOPER_NAME=FINTRACK

# --- Contact ----------------------------------------------------------------
# Leave empty to hide the entry in the Contact Us screen.
SUPPORT_EMAIL=
WEBSITE_URL=
GITHUB_URL=

# --- Currency ---------------------------------------------------------------
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR

# --- Google OAuth (optional) -------------------------------------------------
# These are NO LONGER required to enable Google Sheets. The app now reads them
# at runtime too: Settings -> Google Sheets setup, paste the ids, done - no
# rebuild. See README.md -> "Google Sheets setup" for the exact console steps.
#
# Passing them here is still useful when you build one APK for several devices,
# because the build-time values act as a default the setup screen starts from.
# Obtained from Google Cloud Console -> APIs & Services -> Credentials.
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=
# Convenience alias used when a single ID is valid for the platform in use.
GOOGLE_CLIENT_ID=
